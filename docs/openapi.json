{"openapi":"3.1.0","info":{"title":"Doce Encanto Core API","description":"Session-base API. Authenticate with POST /api/v1/auth/login. Every request that changes state must send the X-Requested-With header. Errors are RFC 9457 problem details with a stable \"code\" property,","version":"v1"},"servers":[{"url":"http://localhost:8080","description":"Generated server url"}],"security":[{"sessionCookie":[]}],"paths":{"/api/v1/auth/logout":{"post":{"tags":["auth-controller"],"summary":"End the current session","operationId":"logout","responses":{"200":{"description":"OK"}}}},"/api/v1/auth/login":{"post":{"tags":["auth-controller"],"summary":"Log in and start a session (204 + SESSION cookie); 401 INVALID_CREDENTIALS on failure","operationId":"login","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LoginRequest"}}},"required":true},"responses":{"200":{"description":"OK"}},"security":[]}},"/api/v1/auth/me":{"get":{"tags":["auth-controller"],"summary":"Return the authenticated user; 401 UNAUTHENTICATED when there is no valid session","operationId":"me","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/MeResponse"}}}}}}}},"components":{"schemas":{"LoginRequest":{"type":"object","properties":{"email":{"type":"string","format":"email","maxLength":255,"minLength":0},"password":{"type":"string","maxLength":72,"minLength":0}},"required":["email","password"]},"MeResponse":{"type":"object","properties":{"email":{"type":"string"}}}},"securitySchemes":{"sessionCookie":{"type":"apiKey","name":"SESSION","in":"cookie"}}}}